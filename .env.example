# Django-Konfiguration
# Secret Key erzeugen:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# 1 = Development-Modus (Debug an), 0 = Production
DJANGO_DEBUG=0

# Komma-getrennte Hosts, unter denen die Seite erreichbar ist
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Datenbank – TimescaleDB / PostgreSQL
# Format: postgres://user:password@host:port/dbname
# Ohne diese Variable greift der SQLite-Fallback fuer die lokale Entwicklung.
DATABASE_URL=postgres://user:password@localhost:5432/vitalportal
